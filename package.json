{
  "name": "otterscript-vscode",
  "displayName": "OtterScript Language Extension",
  "description": "OtterScript language support: syntax highlighting, IntelliSense (hover, completion, signature help), diagnostics with quick fixes, navigation, and snippets.",
  "publisher": "sighanse",
  "author": {
    "name": "Sigurd Hansen",
    "email": "sigurd.hansen@gmail.com",
    "url": "https://github.com/sighanse"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/sighanse/otterscript-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/sighanse/otterscript-vscode/issues"
  },
  "homepage": "https://github.com/sighanse/otterscript-vscode#readme",
  "markdown": "github",
  "license": "MIT",
  "version": "0.5.0",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^65.0.1",
    "globals": "^17.13.0",
    "jsonc-parser": "^3.3.1",
    "ovsx": "^1.2.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "otterscript",
    "otter",
    "inedo",
    "proget",
    "automation",
    "devops",
    "configuration-management",
    "buildmaster",
    "adaptive-cards",
    "teams",
    "webhook"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "otterscript",
        "aliases": [
          "OtterScript",
          "otterscript"
        ],
        "extensions": [
          ".otter",
          ".oscript"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "otterscript",
        "scopeName": "source.otterscript",
        "path": "./syntaxes/otterscript.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "otterscript",
        "path": "./snippets/otterscript.json"
      }
    ],
    "configuration": {
      "title": "OtterScript",
      "properties": {
        "otterscript.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable auto-completion suggestions"
        },
        "otterscript.signatureHelp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable signature help for functions and operations"
        },
        "otterscript.hover.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover information for functions and operations"
        },
        "otterscript.codeLens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeLens reference counts above module declarations"
        },
        "otterscript.workspaceSymbols.enable": {
          "type": "boolean",
          "default": true,
          "description": "Index module declarations across .otter/.oscript files for 'Go to Symbol in Workspace' (Ctrl+T)"
        },
        "otterscript.diagnostics.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Turn off individual OtterScript diagnostics, or change how severe they are, by diagnostic code (shown in the Problems panel). Set a code to `\"off\"` to hide it, or to `\"error\"`, `\"warning\"`, `\"information\"` or `\"hint\"` to change its severity. Codes not listed keep their default.",
          "properties": {
            "unbalanced-symbol": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "Unclosed or unexpected `{` `}`, `(` `)` or `[` `]`."
            },
            "missing-dollar": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A variable in a condition is missing its `$` sigil."
            },
            "assignment-in-condition": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "`=` used in a condition where `==` was probably meant."
            },
            "invalid-operator": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A single `&` or `|` used where `&&` or `||` is required."
            },
            "incorrect-for-usage": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "`for` used as a loop (OtterScript loops use `foreach`)."
            },
            "duplicate-map-key": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "The same key appears twice in a `%(...)` map expression."
            },
            "unknown-scalar-function": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A `$Name(...)` call to a function this extension doesn't know."
            },
            "unknown-vector-function": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An `@Name(...)` call to a function this extension doesn't know."
            },
            "unknown-operation": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An operation call this extension doesn't know."
            },
            "unknown-namespace": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An unknown `Namespace::` qualifier on an operation."
            },
            "too-many-arguments": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A function call with more arguments than the function accepts."
            },
            "template-unexpected-close": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A `%>` with no matching `<%` in a text template."
            },
            "template-unclosed": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A `<%` that is never closed in a text template."
            },
            "template-end-keyword": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "`<% end %>` (or similar) where `<% } %>` is required."
            },
            "template-missing-brace": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A block tag such as `<% if ... %>` missing its `{`."
            },
            "template-in-expression": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A `<% %>` tag inside an unclosed OtterScript expression."
            },
            "adaptivecard-missing-version": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An Adaptive Card without its required `\"version\"` property."
            },
            "adaptivecard-unknown-type": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An unrecognized Adaptive Card element or action `\"type\"`."
            },
            "adaptivecard-version-too-low": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An Adaptive Card element, action or property newer than the card's declared `\"version\"`."
            },
            "adaptivecard-version-too-high": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An Adaptive Card `\"version\"` newer than `#otterscript.adaptiveCards.maxVersion#`, the highest version the target host supports."
            },
            "adaptivecard-invalid-value": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An Adaptive Card property value that isn't one of the property's allowed values, such as `\"weight\": \"bold\"` (should be `\"bolder\"`)."
            },
            "adaptivecard-templating-keyword": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "An Adaptive Card Templating key such as `\"$data\"` or `\"$when\"`, which OtterScript expands as a variable in a text template."
            },
            "adaptivecard-content-type": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "A Teams message attachment holding an Adaptive Card without `\"contentType\": \"application/vnd.microsoft.card.adaptive\"`."
            },
            "adaptivecard-webhook-submit": {
              "type": "string",
              "enum": [
                "off",
                "error",
                "warning",
                "information",
                "hint"
              ],
              "markdownDescription": "`Action.Submit` in a card sent as a Teams message (incoming webhooks and Workflows don't support it)."
            }
          },
          "additionalProperties": false
        },
        "otterscript.adaptiveCards.maxVersion": {
          "type": "string",
          "default": "1.6",
          "pattern": "^\\d+\\.\\d+$",
          "patternErrorMessage": "A card version such as 1.5 or 1.6.",
          "markdownDescription": "The highest Adaptive Card version the host that shows your cards supports. A card whose `\"version\"` is newer gets an `adaptivecard-version-too-high` warning, because the host shows the card's `fallbackText` instead. Microsoft Teams supports up to 1.6."
        }
      }
    },
    "commands": [
      {
        "command": "otterscript.fixAll",
        "title": "Fix All Issues",
        "category": "OtterScript",
        "icon": "$(check-all)"
      }
    ],
    "keybindings": [
      {
        "command": "otterscript.fixAll",
        "key": "ctrl+shift+alt+f",
        "mac": "cmd+shift+alt+f",
        "when": "editorLangId == otterscript && editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "otterscript.fixAll",
          "group": "2_fix@1",
          "when": "editorLangId == otterscript && editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "otterscript.fixAll",
          "when": "editorLangId == otterscript"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "lint:ci": "eslint . --max-warnings=0 --cache",
    "check:js": "npx -y -p typescript@6.0.3 tsc --noEmit -p jsconfig.json && npx -y -p typescript@6.0.3 tsc --noEmit -p test/jsconfig.json && npx -y -p typescript@6.0.3 tsc --noEmit -p scripts/jsconfig.json",
    "check:lang": "node scripts/check-language-sync.js",
    "check:cards": "node scripts/update-adaptivecard-data.js --check",
    "update:cards": "node scripts/update-adaptivecard-data.js --fetch",
    "check:reference": "node scripts/update-inedo-reference.js --check",
    "update:reference": "node scripts/update-inedo-reference.js --fetch && node scripts/check-language-sync.js --write",
    "update:grammar": "node scripts/check-language-sync.js --write",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "vscode-test",
    "test:cov": "node --test --experimental-test-coverage \"test/unit/*.test.js\"",
    "check": "npm run lint:ci && npm run check:js && npm run check:lang && npm run check:cards && npm run check:reference && npm test",
    "package": "vsce package --no-yarn",
    "vscode:prepublish": "npm run lint:ci",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "allowScripts": {
    "@vscode/vsce-sign": true
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.1.2"
    }
  }
}
