// OtterScript snippets: whole statements and blocks. A plain function or operation call comes from completion instead.
{
  "For Each Loop": {
    "prefix": "foreach",
    "body": [
      "foreach $${1:item} in ${2:@(values)} {",
      "    ${3:# loop body}",
      "}"
    ],
    "description": "Iteration block statement"
  },
  "If Statement": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "    ${2:# body}", "}"],
    "description": "Predicate statement"
  },
  "If-Else Statement": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "    ${2:# true body}",
      "} else {",
      "    ${3:# false body}",
      "}"
    ],
    "description": "If-Else predicate statement"
  },
  "Try-Catch Block": {
    "prefix": "try",
    "body": [
      "try {",
      "    ${1:# protected code}",
      "} catch {",
      "    ${2:# error handler}",
      "}"
    ],
    "description": "Try-Catch error handling block"
  },
  "Map Literal": {
    "prefix": "map",
    "body": ["%(", "    ${1:key}: ${2:value}", ")"],
    "description": "Create a map literal using %(...) syntax"
  },
  "Vector Literal": {
    "prefix": "vec",
    "body": ["@(${1:values})"],
    "description": "Create a vector literal"
  },
  "Template Block": {
    "prefix": "template",
    "body": [
      "<% ${1:statement} { %>",
      "    ${2}",
      "<% } %>"],
    "description": "OtterScript text template block using <% %> syntax"
  },
  "Template Foreach": {
    "prefix": "tplforeach",
    "body": [
      "<% foreach ${1:%item} in ${2:@values} { %>",
      "    ${3}",
      "<% } %>"
    ],
    "description": "Template foreach loop"
  },
  "Template If Else": {
    "prefix": "tplif",
    "body": [
      "<% if ${1:condition} { %>",
      "    ${2}",
      "<% } else { %>",
      "    ${3}",
      "<% } %>"
    ],
    "description": "Template if/else block"
  },
  // A whole text-template body for a Teams incoming webhook or Workflows
  // trigger. Values come from OtterScript through $ToJson(...), which adds the
  // JSON quotes and escaping; the <% foreach %> rows start with a comma so the
  // array stays valid JSON however many items there are.
  "Teams Adaptive Card Message": {
    "prefix": "teamscard",
    "body": [
      "{",
      "  \"type\": \"message\",",
      "  \"attachments\": [",
      "    {",
      "      \"contentType\": \"application/vnd.microsoft.card.adaptive\",",
      "      \"content\": {",
      "        \"type\": \"AdaptiveCard\",",
      "        \"version\": \"${1|1.5,1.6,1.4,1.2|}\",",
      "        \"body\": [",
      "          {",
      "            \"type\": \"TextBlock\",",
      "            \"text\": \"${2:Title}\",",
      "            \"size\": \"large\",",
      "            \"weight\": \"bolder\",",
      "            \"wrap\": true",
      "          },",
      "          {",
      "            \"type\": \"TextBlock\",",
      "            \"text\": \\$ToJson(\\$${3:Message}),",
      "            \"wrap\": true",
      "          },",
      "          {",
      "            \"type\": \"FactSet\",",
      "            \"facts\": [",
      "              { \"title\": \"${4:Name}\", \"value\": \\$ToJson(\\$${5:Value}) }",
      "<% foreach %${6:item} in @${7:Items} { %>",
      "              ,{ \"title\": \\$ToJson(%${6:item}.${8:Name}), \"value\": \\$ToJson(%${6:item}.${9:Value}) }",
      "<% } %>",
      "            ]",
      "          }",
      "        ],",
      "        \"actions\": [",
      "          { \"type\": \"Action.OpenUrl\", \"title\": \"${10:Open}\", \"url\": \\$ToJson(\\$${11:Url}) }",
      "        ]",
      "      }",
      "    }",
      "  ]",
      "}$0"
    ],
    "description": "Text-template body that posts an Adaptive Card to a Teams incoming webhook or Workflows trigger"
  },
  "If Match Regex": {
    "prefix": "ifMatchesRegex",
    "body": [
      "if \\$MatchesRegex(${1:text}, \"${2:pattern}\") {",
      "    ${3:# matched}",
      "}"
    ],
    "description": "Test if string matches regex pattern"
  },
  "Split String to Vector": {
    "prefix": "splitToVector",
    "body": [
      "set @${1:parts} = @Split(\"${2:text}\", \"${3:,}\"${4:, ${5:count}});"
    ],
    "description": "Split string into vector using @Split"
  },
  "Join Vector to String": {
    "prefix": "joinIntoString",
    "body": ["set $${1:result} = \\$Join(\"${2:, }\", @${3:vector});"],
    "description": "Join vector elements into a string"
  },
  "File Exists Check": {
    "prefix": "ifexists",
    "body": [
      "if \\$FileExists(\"${1:C:\\\\path\\\\to\\\\file}\") {",
      "    ${2:# file exists}",
      "}"
    ],
    "description": "Check if a file exists"
  },
  "Directory Exists Check": {
    "prefix": "ifdirexists",
    "body": [
      "if \\$DirectoryExists(\"${1:C:\\\\path\\\\to\\\\directory}\") {",
      "    ${2:# directory exists}",
      "}"
    ],
    "description": "Check if a directory exists"
  },
  "With Directive": {
    "prefix": "with",
    "body": ["with ${1:retry=3, timeout=30} {", "    ${2:# operations}", "}"],
    "description": "Execution directive block"
  },
  "Async Block": {
    "prefix": "async",
    "body": ["with async=${1:token} {", "    ${2:# runs in the background}", "}"],
    "description": "Block that runs in the background; wait for it with 'await token;'"
  },
  "Await": {
    "prefix": "await",
    "body": ["await ${1:token};"],
    "description": "Wait for the async blocks with this token (or, without one, for all of them)"
  },
  "Lock Block": {
    "prefix": "lock",
    "body": ["with lock=${1:token} {", "    ${2:# never runs at the same time as another block with this token}", "}"],
    "description": "Block that runs exclusively among the blocks with the same lock token"
  },
  "Module": {
    "prefix": "module",
    "body": ["module ${1:Name}<\\$${2:param}> {", "    ${3:# statements}", "}"],
    "description": "Module declaration, with a parameter"
  },
  "Call Module": {
    "prefix": "call",
    "body": ["call ${1:Name}(${2:param}: ${3:value});"],
    "description": "Module call, with an argument"
  },
  "For Server": {
    "prefix": "forserver",
    "body": ["for server ${1:name} {", "    ${2:# runs against that server}", "}"],
    "description": "Block that runs against one server (Otter and BuildMaster)"
  },
  "For Each Server": {
    "prefix": "foreachserver",
    "body": ["foreach server in @ServersInRole(${1:role}) {", "    ${2:# runs against each server}", "}"],
    "description": "Block that runs against each server in a role (Otter and BuildMaster)"
  },
  "Set Variable": {
    "prefix": "set",
    "body": ["set $${1:variableName} = ${2:value};"],
    "description": "Assign a value to a variable: global, unless a local variable of that name exists"
  },
  "Set Local Variable": {
    "prefix": "setlocal",
    "body": ["set local $${1:variableName} = ${2:value};"],
    "description": "Assign a variable that exists only in the current block"
  },
  "Global Variable": {
    "prefix": "global",
    "body": ["global $${1:variableName} = ${2:value};"],
    "description": "Declare a global variable, at the top of a script before any other statement"
  },
  "Throw Error": {
    "prefix": "throw",
    "body": ["throw \"${1:error message}\";"],
    "description": "Throw an error (can be caught by try-catch)"
  },
  "For Each Affected Package": {
    "prefix": "foreachaffected",
    "body": ["foreach %${1:package} in @AffectedPackages {", "    ${2:# loop body}", "}"],
    "description": "Iterate over the affected packages (ProGet notifiers)"
  },
  "For Each API Key": {
    "prefix": "foreachapikey",
    "body": ["foreach %${1:apiKey} in @ApiKeys {", "    ${2:# loop body}", "}"],
    "description": "Iterate over the API keys (ProGet notifiers)"
  },
  "Region Block": {
    "prefix": "region",
    "body": [
      "#region ${1:Section Name}",
      "    $0",
      "#endregion"
    ],
    "description": "Collapsible region block"
  }
}
