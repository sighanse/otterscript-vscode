# Every text file is stored and checked out with LF line endings (Git detects
# binaries by itself; the common ones are also declared below). This one rule
# covers all file types, so none are listed separately for line endings.
* text=auto eol=lf

# Markdown: Git's built-in diff driver shows the section heading
# (e.g. "## [Unreleased]") in each diff hunk header.
*.md diff=markdown linguist-documentation=true

# Generated: collapsed in pull-request diffs, left out of language stats.
package-lock.json linguist-generated=true

# Binaries
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
*.webp binary
*.zip binary
*.vsix binary linguist-generated=true
