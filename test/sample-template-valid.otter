# SAMPLE-TEMPLATE-VALID.OTTER
#
# A well-formed OtterScript *text template* (ProGet / Otter notification body
# style): literal JSON output with <% ... %> code blocks. It MUST produce zero
# diagnostics — the template-aware pass blanks the literal text between tags and
# only checks the OtterScript inside the tags.
#
# This is the corrected "new vulnerability" webhook body from the milestone
# reference: comma BEFORE each looped item (a static first element makes the
# leading comma valid), $ToJson() on every dynamic value, no <% set %>.
#
# @AffectedPackages elements are maps, so the loop variable is %p (not $p) --
# per the formal grammar, dot/bracket indexing (.Name, [key]) is only defined
# for @ and % sigils, never $. Inside a string, %p.Name must be wrapped as
# $(%p.Name): per strings-and-literals.md, @/% sigils are only auto-recognized
# at the START of a literal expression, so mid-string they need the explicit
# nested-evaluate wrapper. This matches Inedo's own official email example
# for this exact scenario (foreach %p in @AffectedPackages -> $(%p.Name)).
#
# The card also carries the shapes the Adaptive Card check must NOT flag: an
# Action.Submit "data" payload and a Teams "msteams" mention entity, both of
# which use "type" for something other than a card element. It also uses
# RichTextBlock/TextRun (supported by the declared 1.2), and a 1.5 Table that
# is allowed because it has its own "fallback" for older hosts.

{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "content": {
        "type": "AdaptiveCard",
        "version": "1.2",
        "body": [
          {
            "type": "TextBlock",
            "text": "Security Vulnerability Published",
            "size": "medium", "weight": "bolder", "color": "attention", "wrap": true
          },
          {
            "type": "FactSet",
            "facts": [
              { "title": "Package", "value": $ToJson($PackageName $PackageVersion) },
              { "title": "Vulnerability ID", "value": $ToJson($VulnerabilityId) },
              { "title": "Summary", "value": $ToJson($VulnerabilitySummary) }
            ]
          },
          {
            "type": "Container",
            "items": [
              { "type": "TextBlock", "text": "Affected packages:", "weight": "bolder", "wrap": true }
<% foreach %p in @AffectedPackages {   /* a tag-body comment mentioning %> must not close the tag */ %>
              ,{
                "type": "TextBlock",
                "text": $ToJson("- $(%p.Name) $(%p.AffectedVersions)"),
                "wrap": true
              }
<% } %>
            ]
          },
          { "type": "TextBlock", "text": "<at>Security</at> please review.", "wrap": true },
          { "type": "RichTextBlock", "inlines": [ { "type": "TextRun", "text": "Severity: ", "weight": "bolder" }, { "type": "TextRun", "text": "high" } ] },
          { "type": "Table", "fallback": "drop", "columns": [ { "type": "TableColumnDefinition", "width": 1 } ], "rows": [] }
        ],
        "actions": [
          { "type": "Action.OpenUrl", "title": "View", "url": $ToJson($VulnerabilityUrl) },
          { "type": "Action.Submit", "title": "Acknowledge", "data": { "type": "ack", "id": $ToJson($VulnerabilityId) } }
        ],
        "msteams": {
          "entities": [
            { "type": "mention", "text": "<at>Security</at>", "mentioned": { "id": "security@example.com", "name": "Security" } }
          ]
        }
      }
    }
  ]
}

# Below: $(...) interpolation of a loop variable directly in literal template
# text (as opposed to $ToJson(...) above) -- moved here from test/sample.otter,
# which must never contain a real <% %> pair (see the note in that file).
<% foreach %p in @AffectedPackages { %>
* $(%p.Name) $(%p.AffectedVersions)
<% } %>

# Below: a well-formed tag spanning several lines (its '{' is on a later line
# than the keyword) using the % form of $FromJson.
<%
  %severity = %FromJson('{"level": "high"}');
  if $Compare(%severity.level, ==, "high")
  {
%>
Severity: high
<% } %>
